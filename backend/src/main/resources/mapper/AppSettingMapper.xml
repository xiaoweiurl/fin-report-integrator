<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cairui.finreport.settings.AppSettingRepository">
    <resultMap id="settingMap" type="com.cairui.finreport.settings.AppSetting">
        <id column="setting_key" property="key"/>
        <result column="setting_value" property="value"/>
    </resultMap>
    <select id="findById" resultMap="settingMap">
        SELECT setting_key, setting_value FROM app_settings WHERE setting_key = #{key}
    </select>
    <select id="findAll" resultMap="settingMap">
        SELECT setting_key, setting_value FROM app_settings
    </select>
    <insert id="insert">
        INSERT INTO app_settings (setting_key, setting_value) VALUES (#{key}, #{value})
    </insert>
    <update id="update">
        UPDATE app_settings SET setting_value = #{value} WHERE setting_key = #{key}
    </update>
</mapper>
